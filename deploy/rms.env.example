# 生产环境变量模板 — 复制到服务器 /www/wwwroot/rms/backend/rms.env
# 勿将含真实密钥的文件提交 Git；本文件仅列出变量名与说明。
#
# 维护：scripts/ensure-rms-security-env.sh 可 idempotent 补全安全相关项。

# --- 数据库 ---
# MYSQL_JDBC_URL=jdbc:mysql://127.0.0.1:3306/xgsrms?...
# MYSQL_USERNAME=
# MYSQL_PASSWORD=

# --- Redis ---
# REDIS_PASSWORD=

# --- JWT / 接口签名（须与前端 VITE_GLOB_SIGNATURE_SECRET 一致）---
# JWT_SECRET=
# JEECG_SIGNATURE_SECRET=
# CERT-585812：若签名密钥曾泄露（含院通报附件中的 SECRET），必须轮换为新的随机长串，
# 并同步重建前端（VITE_GLOB_SIGNATURE_SECRET），旧密钥立即失效。

# --- 安全策略（Cfg-06 / PROJ-001）---
# CORS 白名单：须与浏览器访问 Origin 一致（HTTP 与 HTTPS 均列出，或全站 HTTPS 后仅 https）
CORS_ALLOWED_ORIGINS=http://10.28.12.15,https://10.28.12.15
# 禁止从 URL ?token= 读取 JWT（生产必须为 false）
JEECG_SECURITY_ALLOW_TOKEN_IN_QUERY=false
# 内网无法出网发信时跳过注册短信/邮箱验证码（生产默认 true）
JEECG_REGISTER_SKIP_SMS=true

# --- 可选 ---
# JEECG_SECURITY_REDIS_REQUIRE_PASSWORD=true
