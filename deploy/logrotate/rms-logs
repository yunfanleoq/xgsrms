# 接口访问日志保留 180 天。安装：sudo cp 到 /etc/logrotate.d/rms-logs
/www/wwwlogs/xgszp-boot.access.log
/www/wwwlogs/10.28.12.15.log
/www/wwwlogs/10.28.12.15.error.log
{
    daily
    rotate 180
    missingok
    notifempty
    compress
    delaycompress
    dateext
    sharedscripts
    postrotate
        if [ -f /www/server/nginx/logs/nginx.pid ]; then
            kill -USR1 "$(cat /www/server/nginx/logs/nginx.pid)"
        fi
    endscript
}

# 应用与安全告警日志保留 90 天
/www/wwwroot/rms/backend/logs/restart-*.log
/www/wwwroot/rms/backend/logs/security-alert.log
{
    daily
    rotate 90
    maxsize 100M
    missingok
    notifempty
    compress
    delaycompress
    dateext
    copytruncate
}
